<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Zytadelle.App.Components"
             x:Class="Zytadelle.App.MainPage"
             BackgroundColor="#050a0f">

    <!-- Blazor mounts into #ui-layer. The arena canvas sits in a layer of its own underneath it,
         declared in index.html and kept out of the component tree on purpose. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#ui-layer" ComponentType="{x:Type components:Shell}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
