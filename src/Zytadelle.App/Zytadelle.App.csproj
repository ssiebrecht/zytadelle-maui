<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Desktop first: Windows is the only target for now. The game core is plain C# and the UI
             is Blazor, so adding a mobile head later costs a TFM and a window, not a rewrite. -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>Zytadelle.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Scoped CSS produces no bundle in MAUI 10 (dotnet/maui#33718); the game ships one global
             stylesheet anyway, ported from the browser build. -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Every number that reaches a CSS value or the save is formatted invariantly. Making the
             whole app invariant as well removes the class of bug where a decimal comma slips out. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <ApplicationTitle>Zytadelle</ApplicationTitle>
        <ApplicationId>de.zytadelle</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Unpackaged: MSIX packaging of a .NET 10 Blazor Hybrid app has an open regression. -->
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#050a0f" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#050a0f" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zytadelle.Balancing\Zytadelle.Balancing.csproj" />
        <ProjectReference Include="..\Zytadelle.Core\Zytadelle.Core.csproj" />
    </ItemGroup>

  <ItemGroup>
    <!-- Zytadelle.Balancing is split by topic; every consumer reads across all of it. -->
    <Using Include="Zytadelle.Balancing" />
    <Using Include="Zytadelle.Balancing.Curves" />
    <Using Include="Zytadelle.Balancing.Enemies" />
    <Using Include="Zytadelle.Balancing.Genes" />
    <Using Include="Zytadelle.Balancing.Infections" />
    <Using Include="Zytadelle.Balancing.Missions" />
  </ItemGroup>

</Project>
