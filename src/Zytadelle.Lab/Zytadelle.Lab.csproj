<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Same head as the game: Windows desktop, Blazor Hybrid. The search itself is plain C# in
             Zytadelle.Lab.Engine, so a different head later costs a TFM and a window. -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Zytadelle.Lab</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Scoped CSS produces no bundle in MAUI 10 (dotnet/maui#33718); the Lab ships one global
             stylesheet anyway, carried over from the browser build's Balance Lab. -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- The tuning sets this app writes have to be readable by anyone, and a decimal comma in a
             curve constant would be a corrupt file rather than a preference. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <ApplicationTitle>Zytadelle Balance Lab</ApplicationTitle>
        <ApplicationId>de.zytadelle.lab</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Unpackaged, same reason as the game: MSIX packaging of a .NET 10 Blazor Hybrid app has
             an open regression. -->
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#050a0f" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#050a0f" BaseSize="128,128" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <!-- The two faces are linked, not copied: one set of files, two apps, and no chance of the
             Lab drifting onto a different Oxanium than the game. -->
        <Content Include="..\Zytadelle.App\wwwroot\fonts\*.woff2" Link="wwwroot\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zytadelle.Lab.Engine\Zytadelle.Lab.Engine.csproj" />
    </ItemGroup>

</Project>
