@inherits LabComponent

@if (Selected is { } f)
{
    var detail = f.Detail;

    <div class="detail">
        <h3>
            <span class="swatch" style="background: @ResultTable.Colour(Host.Selected)"></span>
            @(f.Label ?? $"Build {Host.Selected + 1}")
        </h3>

        <dl class="facts">
            <dt>Time to target <small>sim</small></dt>
            <dd>@(f.ReachedFraction > 0 ? $"{(f.Score / 3600).ToString("F2", Inv)} h ± {(f.StandardError / 3600).ToString("F2", Inv)}" : "never reached")</dd>
            <dt>At &#215;@Host.Speed</dt>
            <dd>@(f.ReachedFraction > 0 ? $"{(f.Score / 3600 / Math.Max(1, Host.Speed)).ToString("F1", Inv)} real hours" : "—")</dd>
            <dt>Reached target</dt>
            <dd>@((f.ReachedFraction * 100).ToString("F0", Inv)) % of campaigns</dd>
            <dt>Cultures</dt>
            <dd>@f.MeanRuns.ToString("F1", Inv)</dd>
            <dt>Toxicity gate</dt>
            <dd>@(f.Strategy.DamageGate ? "on — save for Toxicity until basics die in one hit" : "off")</dd>
            <dt>Levels per unlock</dt>
            <dd>@f.Strategy.UnlockK</dd>
            @if (detail is not null)
            {
                <dt>Charted campaign</dt>
                <dd>seed @f.RepresentativeSeed, @detail.Runs cultures, @((detail.TotalSeconds / 3600).ToString("F1", Inv)) h, @detail.Invested.ToString("N0", Inv) DNA invested</dd>
            }
        </dl>

        <h4>How long each new best cycle took</h4>
        <LadderTable Build="f" />

        @if (detail is not null)
        {
            <WeightTable Title="Gene Lab priority and the levels it bought"
                         Weights="f.Strategy.LabWeights" Levels="detail.Lab" Unlocked="detail.Unlocked" />

            @if (detail.BestRun is { } run)
            {
                <WeightTable Title="In-run priority and the levels the deepest culture bought"
                             Weights="f.Strategy.RunWeights" Levels="run.RunLevels" Unlocked="[]" />
                <p class="pane-note">
                    <b>Bought in this order:</b>
                    @(run.BuyOrder.Count == 0
                        ? "—"
                        : string.Join(" → ", run.BuyOrder.Select(id => UpgradeCatalog.Def(id).Name)))
                </p>
            }
        }
    </div>
}

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private Finalist? Selected =>
        Host.Results.Count == 0 ? null : Host.Results[Math.Clamp(Host.Selected, 0, Host.Results.Count - 1)];
}
