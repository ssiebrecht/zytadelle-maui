@implements IAsyncDisposable
@inject IJSRuntime JS

@* A canvas the JS module owns. Blazor renders the empty host once and never touches its contents,
   so the chart is redrawn only when a new series arrives - not on every re-render of the page. *@

<div class="chart-head">
    <button type="button" class="log @(_log ? "is-on" : null)" @onclick="ToggleLog">log</button>
</div>
<div class="chart" id="@Id"></div>

@code {
    private bool _log;
    private string? _drawn;

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public object[] Series { get; set; } = [];

    [Parameter]
    public string XLabel { get; set; } = "x";

    [Parameter]
    public string YLabel { get; set; } = "y";

    [Parameter]
    public bool Step { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The series is a fresh object graph on every render, so compare what was actually sent
        // rather than the reference - otherwise every progress tick would repaint three charts.
        var signature = System.Text.Json.JsonSerializer.Serialize(Series);
        if (signature == _drawn) { return; }
        _drawn = signature;
        await Safely(() => JS.InvokeVoidAsync("labChart.draw", Id, Series,
            new { xLabel = XLabel, yLabel = YLabel, step = Step }).AsTask());
    }

    private async Task ToggleLog()
    {
        _log = !_log;
        await Safely(() => JS.InvokeVoidAsync("labChart.setLog", Id, _log).AsTask());
    }

    public async ValueTask DisposeAsync()
    {
        await Safely(() => JS.InvokeVoidAsync("labChart.destroy", Id).AsTask());
    }

    /// <summary>The web view can be gone before the component is; that is a teardown, not a fault.</summary>
    private static async Task Safely(Func<Task> call)
    {
        try
        {
            await call();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }
}
