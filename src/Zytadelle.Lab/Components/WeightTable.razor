@* Which genes a build actually put its money into, and how far. Rows the build never touched and
   never emphasised are left out - nineteen rows of zero say nothing. *@

<div class="wtable">
    <h4>@Title</h4>
    @if (Rows.Count == 0)
    {
        <p class="pane-note">Nothing bought.</p>
    }
    else
    {
        @foreach (var r in Rows)
        {
            <div class="wrow" @key="r.Id">
                <span class="wname">
                    @UpgradeCatalog.Def(r.Id).Name
                    @if (Unlocked.Contains(r.Id))
                    {
                        <i>unlocked</i>
                    }
                </span>
                <span class="wbar"><i style="width: @Percent(r.Level)%"></i></span>
                <span class="wlvl">@r.Level</span>
                <span class="wweight">&#215;@r.Weight.ToString("F2", CultureInfo.InvariantCulture)</span>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public double[] Weights { get; set; } = [];

    [Parameter, EditorRequired]
    public Levels Levels { get; set; } = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<UpgradeId> Unlocked { get; set; } = [];

    private record Row(UpgradeId Id, double Weight, int Level);

    private List<Row> Rows =>
        [.. UpgradeIds.All
            .Select(id => new Row(id, Weights[(int)id], Levels[id]))
            .Where(r => r.Level > 0 || r.Weight > 1.05)
            .OrderByDescending(r => r.Level)
            .ThenByDescending(r => r.Weight)];

    private string Percent(int level)
    {
        var max = Math.Max(1, Rows.Count == 0 ? 1 : Rows.Max(r => r.Level));
        return (level / (double)max * 100).ToString("F1", CultureInfo.InvariantCulture);
    }
}
